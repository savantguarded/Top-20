TMDB_API_KEY=your_tmdb_v3_api_key_here

# Optional. Only needed for live config (swapping the poster provider, tuning status-label
# windows, etc. without a redeploy) -- see README "Live config".
# Vercel sets this automatically once you connect an Edge Config store to the project;
# you never need to type it in by hand.
EDGE_CONFIG=

# Optional, only needed if you want the /config settings page (recommended -- a web form
# instead of editing Edge Config's raw JSON by hand). See README "Live config" for how to
# create each of these.
CONFIG_PASSWORD=choose_any_password
VERCEL_API_TOKEN=your_vercel_api_token_here
# Only needed if this Vercel project belongs to a Team, not a personal account.
VERCEL_TEAM_ID=
