TMDB_API_KEY=your_tmdb_v3_api_key

# Optional: fills {mdblist_key} in provider URL templates.
MDBLIST_API_KEY=

# Settings page (see README): served at /backstage-<BACKSTAGE_KEY>. EDGE_CONFIG is added by Vercel when you connect a store.
EDGE_CONFIG=
VERCEL_API_TOKEN=
BACKSTAGE_KEY=
# Only for projects owned by a Vercel team.
VERCEL_TEAM_ID=
