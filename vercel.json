{
  "rewrites": [
    { "source": "/manifest.json", "destination": "/api/manifest" },
    { "source": "/catalog/:type/:id.json", "destination": "/api/catalog?type=:type&id=:id" },
    { "source": "/poster/:type/:imdb/:rank.jpg", "destination": "/api/poster?type=:type&imdb=:imdb&rank=:rank" },
    { "source": "/config", "destination": "/api/config" }
  ],
  "functions": {
    "api/poster.js": {
      "memory": 1024,
      "maxDuration": 15
    },
    "api/catalog.js": {
      "memory": 512,
      "maxDuration": 15
    }
  }
}
