{
  "rewrites": [
    { "source": "/manifest.json", "destination": "/api/manifest" },
    { "source": "/catalog/:type/:id.json", "destination": "/api/catalog?type=:type&id=:id" },
    { "source": "/poster/:type/:imdb/:rank.jpg", "destination": "/api/poster?type=:type&imdb=:imdb&rank=:rank" },
    { "source": "/meta/:type/:id.json", "destination": "/api/meta?type=:type&id=:id" },
    { "source": "/backstage-:key", "destination": "/api/config?key=:key" },

    { "source": "/landscape/manifest.json", "destination": "/api/manifest?layout=landscape" },
    { "source": "/landscape/catalog/:type/:id.json", "destination": "/api/catalog?type=:type&id=:id&layout=landscape" },
    { "source": "/landscape/meta/:type/:id.json", "destination": "/api/meta?type=:type&id=:id" }
  ],
  "functions": {
    "api/poster.js": {
      "memory": 1024,
      "maxDuration": 15
    },
    "api/catalog.js": {
      "memory": 512,
      "maxDuration": 15
    },
    "api/meta.js": {
      "memory": 512,
      "maxDuration": 15
    }
  }
}
